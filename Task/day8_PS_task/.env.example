# Chat provider: ollama or groq
PROVIDER=ollama
CHAT_MODEL=llama3.1
GROQ_API_KEY=your_groq_api_key_here

# Embedding provider: hash (local fallback) or ollama
EMBED_PROVIDER=hash
EMBED_MODEL=nomic-embed-text

# Chroma persistence directory, relative to this project by default
CHROMA_DIR=chroma_db

# Initial starting point only; inspect distances and tune for your setup
MAX_DISTANCE=0.6
